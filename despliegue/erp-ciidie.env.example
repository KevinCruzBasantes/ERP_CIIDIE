# Variables de entorno de producción del ERP CIIDIE.
# Copiar a /etc/erp-ciidie.env con permisos 640 root:erp — NUNCA al repositorio.

# Generar con:
#   python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_GENERADA

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=10.3.21.120,servidorciidie,localhost
# Incluir el puerto si el sitio no está en el 80:
DJANGO_CSRF_TRUSTED_ORIGINS=http://10.3.21.120:8082

DJANGO_DB_ENGINE=mariadb
DJANGO_DB_NAME=erp_ciidie
DJANGO_DB_USER=erp
DJANGO_DB_PASSWORD=CAMBIAR_POR_LA_CLAVE_DE_MARIADB
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=3306

# Rutas de archivos servidos por Nginx
DJANGO_STATIC_ROOT=/opt/erp_ciidie/app/staticfiles
DJANGO_MEDIA_ROOT=/opt/erp_ciidie/app/media

# Minutos de inactividad antes del cierre de sesión automático
SESION_INACTIVIDAD_MINUTOS=30
